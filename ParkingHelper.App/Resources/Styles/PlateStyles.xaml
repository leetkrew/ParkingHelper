<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="PlateCard" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1B2B40}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#DCE6F2, Dark=#334963}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>
    <Style x:Key="SecondaryPlateButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EAF2FF, Dark=#253E5F}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#155BC1, Dark=#C0D9FF}" />
    </Style>
</ResourceDictionary>
