<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="PlateCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
        <Setter Property="Padding" Value="16" />
        <!-- Swipe rows stay within their measured bounds. -->
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>
    <Style x:Key="SecondaryPlateButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource NightSecondary}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource NightSecondaryText}}" />
    </Style>
</ResourceDictionary>
