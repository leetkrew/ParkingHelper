<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             x:Class="ParkingHelper.App.Views.PlateEditorView"
             x:DataType="vm:PlateEditorViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Style="{StaticResource PlateCard}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Plate number" FontAttributes="Bold" />
                <Entry x:Name="PlateInput" Text="{Binding Input}" Placeholder="Enter a plate number"
                       ReturnType="Done" Completed="OnSubmit" IsEnabled="{Binding IsReady}"
                       IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                       MinimumHeightRequest="48" AutomationId="PlateInput" />
                <Label Text="Up to 64 characters. Letters are saved in uppercase."
                       FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Text="{Binding SubmitText}" Clicked="OnSubmit" IsEnabled="{Binding CanSubmit}"
                            AutomationId="SavePlateButton" />
                    <Button Grid.Column="1" Text="Cancel" Clicked="OnCancel" IsVisible="{Binding IsEditing}"
                            IsEnabled="{Binding IsReady}" Style="{StaticResource SecondaryPlateButton}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
            <Label Text="YOUR PLATES" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
            <Button Grid.Column="1" Text="Refresh" Clicked="OnRefresh" Style="{StaticResource SecondaryPlateButton}" />
            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" IsVisible="{Binding HasError}"
                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FFB4AB}" Margin="0,8,0,0"
                   AutomationId="PlateError" />
            <ActivityIndicator Grid.Column="0" HorizontalOptions="End" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </Grid>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Plates}" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectionMode="None"
                        IsEnabled="{Binding IsReady}" AutomationId="PlateList">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="Your saved plates will appear here." Margin="16,24" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlateRow">
                    <views:BoundedSwipeView SwipeStarted="OnSwipeStarted" SwipeEnded="OnSwipeEnded" Unloaded="OnRowUnloaded">
                        <views:BoundedSwipeView.RightItems>
                            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                <views:CompactSwipeAction Text="Move Up" IconImageSource="action_move_up.png" BackgroundColor="{StaticResource Muted}"
                                           IsEnabled="{Binding CanMoveUp}" Invoked="OnMoveUp" />
                                <views:CompactSwipeAction Text="Move Down" IconImageSource="action_move_down.png" BackgroundColor="{StaticResource Muted}"
                                           IsEnabled="{Binding CanMoveDown}" Invoked="OnMoveDown" />
                                <views:CompactSwipeAction Text="Edit" IconImageSource="action_edit.png" BackgroundColor="{StaticResource Primary}" Invoked="OnEdit" />
                                <views:CompactSwipeAction Text="Delete" IconImageSource="action_delete.png" BackgroundColor="{StaticResource Danger}" Invoked="OnDelete" />
                            </SwipeItems>
                        </views:BoundedSwipeView.RightItems>
                        <Border Style="{StaticResource PlateCard}" HorizontalOptions="Fill" MinimumWidthRequest="0" BindingContextChanged="OnRowContextChanged">
                            <Label Text="{Binding PlateNumber}" FontSize="24" FontAttributes="Bold"
                                   LineBreakMode="CharacterWrap" VerticalOptions="Center" />
                        </Border>
                    </views:BoundedSwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
