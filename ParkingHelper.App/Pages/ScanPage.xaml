<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             x:Class="ParkingHelper.App.Pages.ScanPage" x:DataType="vm:ScanViewModel" Title="Scan">
    <ScrollView x:Name="ScanViewport">
        <VerticalStackLayout x:Name="ScanContent" Padding="20,12" Spacing="12" HorizontalOptions="Center">
            <Label Text="Scan your parking ticket" Style="{StaticResource PageHeading}" />
            <Label x:Name="DeviceTime" Style="{StaticResource SupportingText}" />
            <Border x:Name="DesktopSource" IsVisible="False" StrokeShape="RoundRectangle 16" Padding="16" Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark=#334963}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Video Source" FontAttributes="Bold" />
                        <Label x:Name="VideoSourceName" Text="Automatic" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Camera Settings" Style="{StaticResource QuietButton}" Clicked="OnCameraSettings" MinimumHeightRequest="52" />
                </Grid>
            </Border>
            <Grid x:Name="ScanPanels" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="16" ColumnSpacing="20">
            <Grid x:Name="CameraPanel" AutomationId="ScanCameraPanel" HeightRequest="340" BackgroundColor="#0B1628">
                <ContentView x:Name="PreviewHost" InputTransparent="True" />
                <Grid BackgroundColor="Transparent" AutomationId="ScanPreviewTapSurface"
                      SemanticProperties.Description="Tap camera to rescan or retry">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPreviewTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
                <Border x:Name="Target" InputTransparent="True" Stroke="#60A5FA" StrokeThickness="3"
                        StrokeShape="RoundRectangle 20" Margin="36,55" BackgroundColor="Transparent" />
                <Label x:Name="PreviewHint" Text="Tap camera to rescan" TextColor="White" BackgroundColor="#990B1628"
                       Padding="12" VerticalOptions="End" HorizontalTextAlignment="Center" InputTransparent="True" />
            </Grid>
            <VerticalStackLayout x:Name="ScanDetails" Grid.Row="1" Spacing="12" VerticalOptions="Center">
                <VerticalStackLayout x:Name="SelectedPlateSummary" IsVisible="False" Spacing="12">
                    <Label Text="SELECTED PLATE" AutomationId="SelectedPlateHeading" Style="{StaticResource SectionHeading}" />
                    <Label Text="{Binding SelectedPlate.PlateNumber}" FontSize="36" FontAttributes="Bold" LineBreakMode="CharacterWrap" />
                </VerticalStackLayout>
            <Label x:Name="ScanStatus" FontSize="18" FontAttributes="Bold" AutomationId="ScanStatus" />
            <Label Text="{Binding FeedbackDetail}" Style="{StaticResource SupportingText}" />
            </VerticalStackLayout>
            </Grid>
            <Label Text="YOUR PLATES" Style="{StaticResource SectionHeading}" />
            <views:AdaptivePlateLayout BindableLayout.ItemsSource="{Binding Plates}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScanPlateRow">
                        <Button Text="{Binding Label}" Clicked="OnPlateSelected" CommandParameter="{Binding Id}"
                                MinimumHeightRequest="52" Padding="12" LineBreakMode="CharacterWrap"
                                BackgroundColor="{AppThemeBinding Light=#EAF2FF, Dark=#183656}"
                                TextColor="{AppThemeBinding Light=#124A99, Dark=#A7CCFF}"
                                BorderColor="{StaticResource Primary}" BorderWidth="1"
                                SemanticProperties.Description="{Binding Description}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="BorderWidth" Value="3" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </views:AdaptivePlateLayout>
            <Label Text="{Binding PlateStatus}" Style="{StaticResource SupportingText}" />
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween">
                <Button x:Name="CancelButton" Text="Cancel" Style="{StaticResource QuietButton}" Clicked="OnCancel" MinimumHeightRequest="48" />
                <Button x:Name="TorchButton" Text="Torch on" Style="{StaticResource QuietButton}" Clicked="OnTorch" IsVisible="False" MinimumHeightRequest="48" />
                <Button x:Name="SwitchButton" Text="Switch" Style="{StaticResource QuietButton}" Clicked="OnSwitch" MinimumHeightRequest="48" IsVisible="False" />
            </FlexLayout>
            <Button x:Name="ReloadPlatesButton" Text="Reload plates" Clicked="OnRetry" IsVisible="False" MinimumHeightRequest="48" />
            <Button x:Name="OpenSavedButton" Text="Open saved ticket" Clicked="OnRetry" IsVisible="False" MinimumHeightRequest="48" />
            <Button x:Name="PermissionButton" Text="Open system settings" Clicked="OnPermissionSettings" IsVisible="False" MinimumHeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
