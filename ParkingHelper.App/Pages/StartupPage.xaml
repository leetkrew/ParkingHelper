<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingHelper.App.Pages.StartupPage" Title="Parking Helper"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark=#101B2B}">
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center" MaximumWidthRequest="520">
        <Label Text="Parking Helper" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" />
        <Label Text="Scan. Save. Show." HorizontalTextAlignment="Center" />
        <ActivityIndicator x:Name="Loading" IsRunning="True" />
        <Label x:Name="ErrorMessage" IsVisible="False" Text="We couldn’t open your saved plates. Please try again."
               HorizontalTextAlignment="Center" />
        <Button x:Name="RetryButton" Text="Try Again" Clicked="OnRetry" IsVisible="False" />
    </VerticalStackLayout>
</ContentPage>
