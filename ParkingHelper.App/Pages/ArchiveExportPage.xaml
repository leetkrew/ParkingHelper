<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             x:Class="ParkingHelper.App.Pages.ArchiveExportPage"
             x:DataType="vm:ArchiveExportViewModel" Title="Export Archives" Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource NightCanvas}}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Border Style="{StaticResource PageHero}" Background="{StaticResource HeroGradient}">
                <Grid ColumnDefinitions="44,*,44" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Button Text="‹" MinimumWidthRequest="44" FontSize="32" Padding="0" CornerRadius="22"
                            BackgroundColor="#22000000" TextColor="White" Clicked="OnBack" SemanticProperties.Description="Back" />
                    <Label Grid.Column="1" Text="Export Archives" Style="{StaticResource HeroHeading}" FontSize="24"
                           HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Label Grid.Row="1" Grid.ColumnSpan="3" Text="Keep a copy of your parking history."
                           Style="{StaticResource HeroSupportingText}" HorizontalTextAlignment="Center" />
                </Grid>
            </Border>
            <views:ReadableContentView ContentMaximumWidth="760" Margin="0,-24,0,0">
                <VerticalStackLayout Padding="12,0,12,24" Spacing="16">
                    <Border Style="{StaticResource SurfaceCard}" Padding="20,24" StrokeThickness="0">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="Choose your archives" Style="{StaticResource PageHeading}" FontSize="24" />
                            <Label Text="Export all archived tickets, choose individual tickets, or select a date range."
                                   Style="{StaticResource SupportingText}" />
                            <Label Text="EXPORT SCOPE" Style="{StaticResource SectionHeading}" />
                            <Border StrokeShape="RoundRectangle 14" Padding="12,2"
                                    Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource NightOutline}}">
                                <Picker Title="Export scope" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}"
                                        FontSize="17" MinimumHeightRequest="52" />
                            </Border>
                            <VerticalStackLayout IsVisible="{Binding IsSelectedScope}" Spacing="12">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Button Style="{StaticResource QuietButton}" Text="Select All" Clicked="OnSelectAll" MinimumHeightRequest="52" />
                                    <Button Grid.Column="1" Style="{StaticResource QuietButton}" LineBreakMode="WordWrap"
                                            Text="Clear Selection" Clicked="OnClearSelection" MinimumHeightRequest="52" />
                                </Grid>
                                <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" HeightRequest="240">
                                    <CollectionView.EmptyView>
                                        <Label Text="No archived tickets available." Style="{StaticResource SupportingText}" Padding="16" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ArchiveExportTicketViewModel">
                                            <Border Margin="0,0,0,8" Padding="8,10" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource NightCanvas}}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" SemanticProperties.Description="{Binding Summary}" />
                                                    <Label Grid.Column="1" Text="{Binding Summary}" VerticalOptions="Center" FontSize="15" LineBreakMode="WordWrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding IsDateRangeScope}" Spacing="10">
                                <Label Text="From" Style="{StaticResource SupportingText}" />
                                <Border StrokeShape="RoundRectangle 14" Padding="12,2"
                                        Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource NightOutline}}">
                                    <DatePicker Date="{Binding FromDate}" FontSize="17" MinimumHeightRequest="52" SemanticProperties.Description="From date" />
                                </Border>
                                <Label Text="To" Style="{StaticResource SupportingText}" />
                                <Border StrokeShape="RoundRectangle 14" Padding="12,2"
                                        Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource NightOutline}}">
                                    <DatePicker Date="{Binding ToDate}" FontSize="17" MinimumHeightRequest="52" SemanticProperties.Description="To date" />
                                </Border>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource NightOutline}}" />
                            <Label Text="FILE FORMAT" Style="{StaticResource SectionHeading}" />
                            <Border StrokeShape="RoundRectangle 14" Padding="12,2"
                                    Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource NightOutline}}">
                                <Picker Title="File format" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"
                                        FontSize="17" MinimumHeightRequest="52" />
                            </Border>
                            <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource NightSecondary}}">
                                <Label Text="Only archived tickets are included." Style="{StaticResource SupportingText}" />
                            </Border>
                            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FFB4AB}" />
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                            <Button Text="Reload archives" Style="{StaticResource QuietButton}" Clicked="OnReload"
                                    IsVisible="{Binding HasLoadError}" IsEnabled="{Binding CanExport}" MinimumHeightRequest="52" />
                            <Button Text="Export" Clicked="OnExport" IsEnabled="{Binding CanExport}"
                                    MinimumHeightRequest="56" CornerRadius="18" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </views:ReadableContentView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
