<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             x:Class="ParkingHelper.App.Pages.TicketsPage" x:DataType="vm:TicketsViewModel" Title="Tickets" Shell.NavBarIsVisible="False" Background="{StaticResource HeroGradient}">
    <Grid x:Name="TicketsViewport" RowDefinitions="Auto,*">
        <Border Style="{StaticResource PageHero}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Tickets" Style="{StaticResource HeroHeading}" />
                    <Label Text="Manage your parking tickets" Style="{StaticResource HeroSupportingText}" />
                </VerticalStackLayout>
            </Border>
        <Border Grid.Row="1" Style="{StaticResource ContentSheet}" Padding="0">
    <Grid x:Name="TicketsContent" HorizontalOptions="Center" Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource NightSecondary}}" MaximumWidthRequest="600">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
            <Button Text="Active Tickets" Clicked="OnActive" MinimumHeightRequest="52" Style="{StaticResource SegmentButton}">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter Property="TextColor" Value="White"/></DataTrigger></Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="Archived" Clicked="OnArchived" MinimumHeightRequest="52" Style="{StaticResource SegmentButton}">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsArchived}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter Property="TextColor" Value="White"/></DataTrigger></Button.Triggers>
            </Button>
        </Grid>
        </Border>
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Button Text="Export Archives" Style="{StaticResource QuietButton}" HorizontalOptions="End" IsVisible="{Binding IsArchived}" Clicked="OnExport" MinimumHeightRequest="52" />
            <Label Text="{Binding Error}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FFB4AB}" IsVisible="{Binding HasError}" />
            <Button Text="Retry" IsVisible="{Binding HasError}" Clicked="OnRetry" />
        </VerticalStackLayout>
        <Grid Grid.Row="2">
        <RefreshView IsEnabled="{Binding ShowContent}" x:Name="TicketRefresh" IsRefreshing="{Binding IsRefreshing, Mode=OneWay}" Refreshing="OnRefreshing">
        <CollectionView ItemsSource="{Binding Items}" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectionMode="None" IsVisible="{Binding ShowContent}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="TicketItemsLayout" Orientation="Vertical" Span="1" HorizontalItemSpacing="16" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,48" Spacing="12" IsVisible="{Binding ShowEmpty}" MaximumWidthRequest="440" HorizontalOptions="Center">
                    <Image Source="nav_tickets.png" HeightRequest="40" WidthRequest="40" SemanticProperties.Description="Tickets" />
                    <Label Text="{Binding EmptyTitle}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding EmptyDetail}" Style="{StaticResource SupportingText}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TicketRowViewModel">
                    <views:BoundedSwipeView SwipeStarted="OnSwipeStarted" SwipeEnded="OnSwipeEnded" Unloaded="OnRowUnloaded">
                        <views:BoundedSwipeView.RightItems>
                            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                <views:CompactSwipeAction Text="Edit" IconImageSource="action_edit.png" BackgroundColor="{StaticResource Primary}" Invoked="OnEditTicket" />
                                <views:CompactSwipeAction Text="{Binding StateAction}" IconImageSource="{Binding StateActionIcon}" BackgroundColor="{StaticResource Muted}" Invoked="OnChangeTicketState" />
                                <views:CompactSwipeAction Text="Delete" IconImageSource="action_delete.png" BackgroundColor="{StaticResource Danger}" Invoked="OnDeleteTicket" />
                            </SwipeItems>
                        </views:BoundedSwipeView.RightItems>
                    <Border BindingContextChanged="OnRowContextChanged" Style="{StaticResource PlateCard}" HorizontalOptions="Fill" MinimumWidthRequest="0">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTicketTapped" CommandParameter="{Binding Id}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" IsClippedToBounds="True" HorizontalOptions="Fill">
                            <Label Text="{Binding PlateNumber}" FontSize="30" FontAttributes="Bold" LineBreakMode="CharacterWrap" />
                            <Label Text="{Binding SavedLocalTime}" Style="{StaticResource SupportingText}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding ArchivedLocalTime}" Style="{StaticResource SupportingText}" IsVisible="{Binding IsArchived}" />
                            <Label Text="{Binding Duration}" LineBreakMode="WordWrap" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </VerticalStackLayout>
                    </Border>
                    </views:BoundedSwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
    </Border>
    </Grid>
</ContentPage>
