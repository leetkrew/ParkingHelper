<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             x:Class="ParkingHelper.App.Pages.TicketsPage" x:DataType="vm:TicketsViewModel" Title="Tickets">
    <Grid x:Name="TicketsViewport">
    <Grid x:Name="TicketsContent" HorizontalOptions="Center" Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" MaximumWidthRequest="600">
            <Button Text="Active Tickets" Clicked="OnActive" MinimumHeightRequest="52" BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource Gray900}">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter Property="TextColor" Value="White"/></DataTrigger></Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="Archived" Clicked="OnArchived" MinimumHeightRequest="52" BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource Gray900}">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsArchived}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter Property="TextColor" Value="White"/></DataTrigger></Button.Triggers>
            </Button>
        </Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Button Text="Export Archives" IsVisible="{Binding IsArchived}" Clicked="OnExport" MinimumHeightRequest="52" />
            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" />
            <Button Text="Retry" IsVisible="{Binding HasError}" Clicked="OnRetry" />
        </VerticalStackLayout>
        <Grid Grid.Row="2">
        <RefreshView IsEnabled="{Binding ShowContent}" x:Name="TicketRefresh" IsRefreshing="{Binding IsRefreshing, Mode=OneWay}" Refreshing="OnRefreshing">
        <CollectionView ItemsSource="{Binding Items}" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectionMode="None" IsVisible="{Binding ShowContent}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="TicketItemsLayout" Orientation="Vertical" Span="1" HorizontalItemSpacing="16" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="12" IsVisible="{Binding ShowEmpty}">
                    <Label Text="{Binding EmptyTitle}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding EmptyDetail}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TicketRowViewModel">
                    <views:BoundedSwipeView SwipeStarted="OnSwipeStarted" SwipeEnded="OnSwipeEnded" Unloaded="OnRowUnloaded">
                        <views:BoundedSwipeView.RightItems>
                            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                <views:CompactSwipeAction Text="Edit" IconImageSource="action_edit.png" BackgroundColor="#2457A7" Invoked="OnEditTicket" />
                                <views:CompactSwipeAction Text="{Binding StateAction}" IconImageSource="{Binding StateActionIcon}" BackgroundColor="#52647A" Invoked="OnChangeTicketState" />
                                <views:CompactSwipeAction Text="Delete" IconImageSource="action_delete.png" BackgroundColor="#B42318" Invoked="OnDeleteTicket" />
                            </SwipeItems>
                        </views:BoundedSwipeView.RightItems>
                    <Border BindingContextChanged="OnRowContextChanged" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}" HorizontalOptions="Fill" MinimumWidthRequest="0" Padding="16" StrokeShape="RoundRectangle 20" Stroke="{StaticResource Primary}">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTicketTapped" CommandParameter="{Binding Id}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" IsClippedToBounds="True" HorizontalOptions="Fill">
                            <Label Text="{Binding PlateNumber}" FontSize="30" FontAttributes="Bold" LineBreakMode="CharacterWrap" />
                            <Label Text="{Binding SavedLocalTime}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding ArchivedLocalTime}" IsVisible="{Binding IsArchived}" />
                            <Label Text="{Binding Duration}" LineBreakMode="WordWrap" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </VerticalStackLayout>
                    </Border>
                    </views:BoundedSwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
    </Grid>
</ContentPage>
