<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingHelper.App.Pages.SettingsPage"
             Title="Settings">
    <ScrollView>
    <views:ReadableContentView>
    <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="720">
        <Label Text="Your Vehicles" FontSize="28" FontAttributes="Bold" />
        <Label Text="Keep your plate numbers ready for your next parking visit." />
        <Button Text="Manage Plate Numbers" Clicked="OnManagePlates" AutomationId="ManagePlatesButton" />
        <BoxView HeightRequest="1" Margin="0,8" />
        <Label Text="Scanning" FontSize="28" FontAttributes="Bold" />
        <VerticalStackLayout Spacing="8">
            <Button Text="Scanner Settings" Clicked="OnScannerSettings" />
            <Label Text="Choose which barcode formats to scan." />
        </VerticalStackLayout>
        <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
            <Button Text="Camera Settings" Clicked="OnCameraSettings" />
            <Label Text="Choose a camera or video source." />
        </VerticalStackLayout>
        <BoxView HeightRequest="1" Margin="0,8" />
        <Label Text="Google Drive" FontSize="28" FontAttributes="Bold" />
        <Label x:Name="AccountNameLabel" IsVisible="False" FontAttributes="Bold" />
        <Label x:Name="AccountEmailLabel" IsVisible="False" />
        <Label x:Name="SyncStatusLabel" IsVisible="False" />
        <Label x:Name="LastSyncLabel" IsVisible="False" />
        <ActivityIndicator x:Name="DriveActivity" IsVisible="False" />
        <Button x:Name="ConnectDriveButton" Text="Connect to Google Drive" Clicked="OnConnectDrive" AutomationId="ConnectDriveButton" />
        <HorizontalStackLayout Spacing="12">
            <Button x:Name="SyncNowButton" Text="Sync Now" Clicked="OnSyncNow" IsVisible="False" AutomationId="SyncNowButton" />
            <Button x:Name="DisconnectDriveButton" Text="Disconnect" Clicked="OnDisconnectDrive" IsVisible="False" AutomationId="DisconnectDriveButton" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
    </views:ReadableContentView>
    </ScrollView>
</ContentPage>
