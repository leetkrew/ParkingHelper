<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingHelper.App.Pages.SettingsPage"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark={StaticResource Gray950}}">
    <ContentPage.Resources>
        <Style x:Key="SectionHeader" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="1" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            <Setter Property="Margin" Value="20,24,20,8" />
            <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style x:Key="Rows" TargetType="VerticalStackLayout">
            <Setter Property="Spacing" Value="0" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}" />
        </Style>
        <Style x:Key="Separator" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="0.5" />
            <Setter Property="Margin" Value="20,0,0,0" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <views:ReadableContentView>
            <VerticalStackLayout Padding="0,0,0,32" Spacing="0">
                <Label Text="YOUR VEHICLES" Style="{StaticResource SectionHeader}" />
                <VerticalStackLayout Style="{StaticResource Rows}">
                    <views:SettingsRow Text="Plate Numbers" Clicked="OnManagePlates" AutomationId="ManagePlatesButton" />
                </VerticalStackLayout>

                <Label Text="SCANNING" Style="{StaticResource SectionHeader}" />
                <VerticalStackLayout Style="{StaticResource Rows}">
                    <views:SettingsRow Text="Scanner Settings" Clicked="OnScannerSettings" />
                    <BoxView Style="{StaticResource Separator}" />
                    <views:SettingsRow Text="Camera Settings" Clicked="OnCameraSettings" />
                </VerticalStackLayout>

                <Label Text="GOOGLE DRIVE" Style="{StaticResource SectionHeader}" />
                <VerticalStackLayout Style="{StaticResource Rows}">
                    <views:SettingsRow x:Name="ConnectDriveButton" Text="Connect to Google Drive" Clicked="OnConnectDrive" AutomationId="ConnectDriveButton" />
                    <VerticalStackLayout x:Name="ConnectedDriveRows" Spacing="0" IsVisible="False">
                        <VerticalStackLayout x:Name="AccountRow" Padding="20,14" Spacing="4">
                            <Label x:Name="AccountNameLabel" FontSize="17" IsVisible="False" />
                            <Label x:Name="AccountEmailLabel" Style="{StaticResource SecondaryText}" IsVisible="False" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource Separator}" />
                        <VerticalStackLayout Padding="20,14" Spacing="4">
                            <Label Text="Last Sync" FontSize="17" />
                            <Label x:Name="LastSyncLabel" Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource Separator}" />
                        <views:SettingsRow x:Name="SyncNowButton" Text="Sync Now" Clicked="OnSyncNow" AutomationId="SyncNowButton" />
                        <BoxView Style="{StaticResource Separator}" />
                    </VerticalStackLayout>
                    <views:SettingsRow Text="Drive Diagnostics" Clicked="OnDriveDiagnostics" AutomationId="DriveDiagnosticsRow" />
                    <VerticalStackLayout x:Name="DisconnectDriveRows" Spacing="0" IsVisible="False">
                        <BoxView Style="{StaticResource Separator}" />
                        <views:SettingsRow x:Name="DisconnectDriveButton" Text="Disconnect" Clicked="OnDisconnectDrive" AutomationId="DisconnectDriveButton" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <Grid x:Name="DriveStatusRow" Padding="20,8" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="False">
                    <ActivityIndicator x:Name="DriveActivity" HeightRequest="18" WidthRequest="18" VerticalOptions="Start" IsVisible="False" />
                    <Label x:Name="SyncStatusLabel" Grid.Column="1" Style="{StaticResource SecondaryText}" IsVisible="False" />
                </Grid>


                <Label Text="ABOUT" Style="{StaticResource SectionHeader}" />
                <VerticalStackLayout Style="{StaticResource Rows}">
                    <views:SettingsRow Text="About Parking Helper" Clicked="OnAbout" />
                    <BoxView Style="{StaticResource Separator}" />
                    <views:SettingsRow Text="Privacy Policy" Clicked="OnPrivacyPolicy" />
                    <BoxView Style="{StaticResource Separator}" />
                    <Grid Padding="20,14" ColumnDefinitions="*,Auto" ColumnSpacing="16" MinimumHeightRequest="52">
                        <Label Text="Version" FontSize="17" VerticalOptions="Center" />
                        <Label x:Name="VersionLabel" Grid.Column="1" Style="{StaticResource SecondaryText}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </views:ReadableContentView>
    </ScrollView>
</ContentPage>
