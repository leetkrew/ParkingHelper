<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingHelper.App.Pages.SettingsPage"
             Title="Settings">
    <ScrollView>
    <views:ReadableContentView>
    <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="720">
        <Label Text="Your vehicles" FontSize="28" FontAttributes="Bold" />
        <Label Text="Keep your plate numbers ready for your next parking visit." />
        <Button Text="Manage Plate Numbers" Clicked="OnManagePlates" AutomationId="ManagePlatesButton" />
        <Button Text="Scanner Settings" Clicked="OnScannerSettings" />
        <Button Text="Camera Settings" Clicked="OnCameraSettings" />
        <BoxView HeightRequest="1" Margin="0,8" />
        <Label Text="Google Drive synchronization" FontSize="22" FontAttributes="Bold" />
        <Label Text="Optional sync is offline-safe. Local data remains available when disconnected." />
        <Label x:Name="SyncStatusLabel" Text="Not synchronized" />
        <HorizontalStackLayout Spacing="12">
            <Button Text="Connect Google Drive" Clicked="OnConnectDrive" />
            <Button Text="Sync Now" Clicked="OnSyncNow" />
            <Button Text="Disconnect" Clicked="OnDisconnectDrive" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
    </views:ReadableContentView>
    </ScrollView>
</ContentPage>
