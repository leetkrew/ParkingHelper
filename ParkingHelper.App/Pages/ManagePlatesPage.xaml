<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             x:Class="ParkingHelper.App.Pages.ManagePlatesPage" x:DataType="vm:PlateEditorViewModel"
             Title="Manage Plate Numbers" BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource NightCanvas}}">
    <views:ReadableContentView>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Padding="20" MaximumWidthRequest="720">
        <VerticalStackLayout Spacing="8">
            <Border Style="{StaticResource HeroCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Your vehicles" Style="{StaticResource HeroHeading}" />
                    <Label Text="Manage Plate Numbers" Style="{StaticResource HeroSupportingText}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Swipe a plate left for actions. On Mac, right-click or Control-click." TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
        </VerticalStackLayout>
        <views:PlateEditorView x:Name="Editor" Grid.Row="1" />

    </Grid>
    </views:ReadableContentView>
</ContentPage>
