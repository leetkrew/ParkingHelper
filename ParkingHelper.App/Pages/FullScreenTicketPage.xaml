<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             x:Class="ParkingHelper.App.Pages.FullScreenTicketPage" x:DataType="vm:TicketPreviewViewModel"
             Title="Present ticket" Shell.TabBarIsVisible="False" Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Label Text="{Binding PlateNumber}" IsVisible="{Binding IsLoaded}" FontSize="56" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <views:TicketBarcodeView Barcode="{Binding Barcode}" IsVisible="{Binding IsLoaded}" HeightRequest="300" />
            <Label Text="{Binding Status}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding Duration, StringFormat='Duration {0}'}" IsVisible="{Binding IsLoaded}" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button x:Name="WalletButton" Text="Open Wallet" IsVisible="False" Clicked="OnWallet" MinimumHeightRequest="52" />
            <Button Text="Retry" IsVisible="{Binding CanRetry}" Clicked="OnRetry" MinimumHeightRequest="52" />
            <Button Text="Done" Clicked="OnDone" MinimumHeightRequest="52" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
