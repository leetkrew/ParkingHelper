<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             x:Class="ParkingHelper.App.Pages.FullScreenTicketPage" x:DataType="vm:TicketPreviewViewModel"
             Title="Present ticket" Shell.TabBarIsVisible="False" Shell.NavBarIsVisible="False">
    <ScrollView x:Name="PresentationViewport">
        <Grid x:Name="PresentationContent" Padding="24" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*"
              RowSpacing="20" ColumnSpacing="28" HorizontalOptions="Center">
            <Label x:Name="PresentationPlate" AutomationId="PresentationPlate" Text="{Binding PlateNumber}" IsVisible="{Binding IsLoaded}" FontSize="56"
                   FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="CharacterWrap" VerticalOptions="End" />
            <views:TicketBarcodeView x:Name="PresentationBarcode" AutomationId="PresentationBarcode" Grid.Row="1" Barcode="{Binding Barcode}"
                                    IsVisible="{Binding IsLoaded}" HeightRequest="300" MaximumWidthRequest="640" VerticalOptions="Center" />
            <VerticalStackLayout x:Name="PresentationDetails" Grid.Row="2" Spacing="20" MaximumWidthRequest="480">
                <Label Text="{Binding Status}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Duration, StringFormat='Duration {0}'}" IsVisible="{Binding IsLoaded}" FontSize="28"
                       FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Button x:Name="WalletButton" Text="Open Wallet" IsVisible="False" Clicked="OnWallet" MinimumHeightRequest="52" />
                <Button Text="Retry" IsVisible="{Binding CanRetry}" Clicked="OnRetry" MinimumHeightRequest="52" />
                <Button Text="Done" Clicked="OnDone" MinimumHeightRequest="52" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
