<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             x:Class="ParkingHelper.App.Pages.InitialSetupPage" x:DataType="vm:PlateEditorViewModel"
             Title="Add Your Plate Numbers" BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark=#101B2B}">
    <views:ReadableContentView>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Padding="20" MaximumWidthRequest="720">
        <VerticalStackLayout Spacing="8">
            <Label Text="Add Your Plate Numbers" Style="{StaticResource PageHeading}" />
            <Label Text="Add at least one plate to get started. You can add more plates later in Settings." TextColor="{AppThemeBinding Light=#52647A, Dark=#B8C8DE}" />
        </VerticalStackLayout>
        <views:PlateEditorView x:Name="Editor" Grid.Row="1" />
        <Button Grid.Row="2" Text="Continue" Clicked="OnContinue" IsEnabled="{Binding CanContinue}"
                AutomationId="ContinueButton" Margin="0,8,0,0" />
    </Grid>
    </views:ReadableContentView>
</ContentPage>
