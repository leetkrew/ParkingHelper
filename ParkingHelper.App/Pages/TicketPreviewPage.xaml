<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ParkingHelper.Core.Models;assembly=ParkingHelper.Core"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             x:Class="ParkingHelper.App.Pages.TicketPreviewPage" x:DataType="vm:TicketPreviewViewModel"
             Title="Ticket Preview" Shell.TabBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="720">
            <Label Text="{Binding Status}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <VerticalStackLayout IsVisible="{Binding IsLoaded}" Spacing="24">
                <Label Text="{Binding PlateNumber}" FontSize="48" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                <views:TicketBarcodeView Barcode="{Binding Barcode}" HeightRequest="260" />
                <Label Text="Saved" FontSize="16" HorizontalTextAlignment="Center" />
                <Label Text="{Binding SavedLocalTime}" FontSize="20" HorizontalTextAlignment="Center" />
                <Label Text="Parking duration" FontSize="16" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Duration}" FontSize="36" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Button Text="Archive" Clicked="OnArchive" IsVisible="{Binding IsActive}" IsEnabled="{Binding CanAct}" MinimumHeightRequest="52" />
                <Button Text="Edit plate number" Clicked="OnEditPlate" IsEnabled="{Binding CanAct}" MinimumHeightRequest="52" />
                <VerticalStackLayout IsVisible="{Binding IsEditingPlate}" Spacing="12">
                    <Label Text="Plate number for this ticket" FontAttributes="Bold" />
                    <Picker Title="Select a saved plate" ItemsSource="{Binding PlateChoices}" SelectedItem="{Binding SelectedPlate}"
                            ItemDisplayBinding="{Binding PlateNumber, x:DataType=models:VehiclePlate}" MinimumHeightRequest="52" />
                    <Button Text="Confirm plate change" Clicked="OnConfirmPlate" IsEnabled="{Binding CanConfirmPlate}" MinimumHeightRequest="52" />
                    <Button Text="Cancel" Clicked="OnCancelPlate" MinimumHeightRequest="52" />
                </VerticalStackLayout>
                <Button Text="Show Full Screen" Clicked="OnFullScreen" IsEnabled="{Binding CanAct}" MinimumHeightRequest="52" />
                <Button x:Name="WalletButton" Text="Open Wallet" Clicked="OnWallet" IsVisible="False" MinimumHeightRequest="52" />
                <Button Text="Restore to Active" Clicked="OnRestore" IsVisible="{Binding IsArchived}" IsEnabled="{Binding CanAct}" MinimumHeightRequest="52" />
                <Button Text="Delete ticket" Clicked="OnDelete" BackgroundColor="Red" IsEnabled="{Binding CanAct}" MinimumHeightRequest="52" />
            </VerticalStackLayout>
            <Button Text="Retry" IsVisible="{Binding CanRetry}" Clicked="OnRetry" MinimumHeightRequest="52" />
            <Button Text="Done" Clicked="OnDone" MinimumHeightRequest="52" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
