<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ParkingHelper.App.Views"
             xmlns:vm="clr-namespace:ParkingHelper.App.ViewModels"
             x:Class="ParkingHelper.App.Pages.TicketPreviewPage" x:DataType="vm:TicketPreviewViewModel"
             Title="Ticket Preview" Shell.NavBarIsVisible="True" Shell.BackgroundColor="{StaticResource HeroBlue}" Shell.TitleColor="White" Shell.ForegroundColor="White" Background="{StaticResource HeroGradient}">
    <ContentPage.Resources>
        <Style x:Key="TicketAction" TargetType="Button">
                        <Setter Property="MinimumHeightRequest" Value="52" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource NightSecondary}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"><VisualState.Setters><Setter Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    <ScrollView x:Name="TicketViewport">
    <views:ReadableContentView ContentMaximumWidth="760">
        <VerticalStackLayout Padding="0" Spacing="0">
            <Border Style="{StaticResource PageHero}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Ticket preview" Style="{StaticResource HeroHeading}" />
                    <Label Text="{Binding Status}" Style="{StaticResource HeroSupportingText}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource ContentSheet}">
            <VerticalStackLayout Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Border StrokeThickness="0" Padding="0" IsVisible="{Binding IsLoaded}">
            <VerticalStackLayout Spacing="16">
                <Label Text="{Binding PlateNumber}" FontSize="48" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" LineBreakMode="CharacterWrap" />
                <views:TicketBarcodeView x:Name="TicketBarcode" MaximumWidthRequest="640" Barcode="{Binding Barcode}" HeightRequest="260" />
                <Label Text="{Binding SavedLocalTime}" Style="{StaticResource SupportingText}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Duration}" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <VerticalStackLayout IsVisible="{Binding IsEditingPlate}" Spacing="12">
                    <Label Text="Edit Ticket" FontSize="22" FontAttributes="Bold" />
                    <Label Text="{Binding PlateNumber, StringFormat='Current: {0}'}" />
                    <views:AdaptivePlateLayout CompactSingleColumn="True" BindableLayout.ItemsSource="{Binding PlateChoices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TicketPlateChoice">
                                <Button Text="{Binding PlateNumber}" CommandParameter="{Binding Id}" Clicked="OnSelectPlate"
                                        MinimumHeightRequest="56" LineBreakMode="CharacterWrap" Style="{StaticResource QuietButton}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="Text" Value="{Binding PlateNumber, StringFormat='✓  {0}'}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </views:AdaptivePlateLayout>
                    <Label Text="Entry date/time (local)" />
                    <DatePicker Date="{Binding EntryDate, Mode=TwoWay}" />
                    <TimePicker Time="{Binding EntryTime, Mode=TwoWay}" Format="HH:mm:ss" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Cancel" Style="{StaticResource QuietButton}" Clicked="OnCancelPlate" MinimumHeightRequest="52" />
                        <Button Grid.Column="1" Text="Save" Clicked="OnConfirmPlate" IsEnabled="{Binding CanConfirmPlate}" MinimumHeightRequest="52" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
            </Border>
            <Grid x:Name="TicketActions" AutomationId="TicketActions" MaximumWidthRequest="600" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Grid.Row="0" Grid.Column="0" Text="Full Screen" Style="{StaticResource TicketAction}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White" FontAttributes="Bold"
                        Clicked="OnFullScreen" IsEnabled="{Binding CanAct}" />
                <Button Grid.Row="0" Grid.Column="1" x:Name="WalletButton" Text="Open Wallet" Style="{StaticResource TicketAction}"
                        Clicked="OnWallet" IsEnabled="False" />
                <Button Grid.Row="0" Grid.Column="2" Text="Details" Style="{StaticResource TicketAction}" Clicked="OnDetails" IsEnabled="{Binding CanAct}" />
                <Button Grid.Row="1" Grid.Column="0" Text="Edit" Style="{StaticResource TicketAction}"
                        Clicked="OnEditPlate" IsEnabled="{Binding CanAct}" />
                <Button Grid.Row="1" Grid.Column="1" Text="Archive" Style="{StaticResource TicketAction}"
                        Clicked="OnArchive" IsVisible="{Binding IsActive}" IsEnabled="{Binding CanAct}" />
                <Button Grid.Row="1" Grid.Column="1" Text="Restore" Style="{StaticResource TicketAction}"
                        Clicked="OnRestore" IsVisible="{Binding IsArchived}" IsEnabled="{Binding CanAct}" />
                <Button Grid.Row="1" Grid.Column="2" Text="Delete" Style="{StaticResource TicketAction}"
                        BackgroundColor="{AppThemeBinding Light=#FEECEB, Dark=#4A2226}"
                        TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FFB4AB}"
                        Clicked="OnDelete" IsEnabled="{Binding CanAct}" />
            </Grid>
            <Button Text="Retry" IsVisible="{Binding CanRetry}" Clicked="OnRetry" MinimumHeightRequest="52" />
            </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </views:ReadableContentView>
    </ScrollView>
</ContentPage>
