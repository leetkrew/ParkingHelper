<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <!-- Optional local/CI subset when only some platform workloads are installed. -->
        <TargetFrameworks Condition="'$(ParkingHelperBuildTargets)' != ''">$(ParkingHelperBuildTargets)</TargetFrameworks>

        <!-- Note for MacCatalyst:
        The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
        When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
        The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
        either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>ParkingHelper.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Parking Helper</ApplicationTitle>
        <!-- Keep the bundle filename aligned with IDE launchers while preserving the user-facing title. -->
        <_AppBundleName Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">$(AssemblyName)</_AppBundleName>

        <!-- App Identifier -->
        <ApplicationId>dev.2radical.parkinghelper</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>


        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <!-- Google Identity AuthorizationClient requires Android API 23 or newer. -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
        <GoogleAuthConfigPath Condition="'$(GoogleAuthConfigPath)' == '' and Exists('$(MSBuildProjectDirectory)/GoogleAuth.local.json')">$(MSBuildProjectDirectory)/GoogleAuth.local.json</GoogleAuthConfigPath>
        <GoogleAuthConfigPath Condition="'$(GoogleAuthConfigPath)' == ''">$(HOME)/.config/ParkingHelper/GoogleAuth.local.json</GoogleAuthConfigPath>
        <GoogleAuthConfigGeneratorProject>$(MSBuildProjectDirectory)/../Build/GoogleAuthConfigGenerator/GoogleAuthConfigGenerator.csproj</GoogleAuthConfigGeneratorProject>
        <GoogleAuthGeneratedOutputDirectory>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)</GoogleAuthGeneratedOutputDirectory>
        <GoogleAuthGeneratedCSharp>$(GoogleAuthGeneratedOutputDirectory)/GoogleAuth.Generated.cs</GoogleAuthGeneratedCSharp>
        <GoogleAuthGeneratedPlist>$(GoogleAuthGeneratedOutputDirectory)/GoogleAuth.Callback.plist</GoogleAuthGeneratedPlist>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4"/>

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128"/>

        <!-- Images -->
        <MauiImage Include="Resources\Images\*"/>

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*"/>

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../ParkingHelper.Core/ParkingHelper.Core.csproj" />
        <ProjectReference Include="../ParkingHelper.Persistence/ParkingHelper.Persistence.csproj" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0"/>
        <PackageReference Include="Xamarin.GooglePlayServices.Auth" Version="121.6.0.2" Condition="'$(TargetFramework)' == 'net10.0-android'" />
        <!-- Keep Fragment and Fragment.Ktx on the same AndroidX release to avoid duplicate JVM classes. -->
        <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    </ItemGroup>

    <Target Name="GenerateGoogleAuthConfiguration"
            BeforeTargets="CoreCompile;_CompileAppManifestInputs"
            Condition="'$(GoogleAuthConfigurationGenerated)' != 'true' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and ('$(TargetFramework)' == 'net10.0-android' or '$(TargetFramework)' == 'net10.0-ios' or '$(TargetFramework)' == 'net10.0-maccatalyst')">
        <Exec Command="dotnet run --project &quot;$(GoogleAuthConfigGeneratorProject)&quot; --no-launch-profile -- &quot;$(GoogleAuthConfigPath)&quot; &quot;$(GoogleAuthGeneratedCSharp)&quot; &quot;$(GoogleAuthGeneratedPlist)&quot; &quot;$(TargetFramework)&quot;" />
        <ItemGroup>
            <Compile Include="$(GoogleAuthGeneratedCSharp)" />
            <PartialAppManifest Include="$(GoogleAuthGeneratedPlist)" Condition="'$(TargetFramework)' == 'net10.0-ios' or '$(TargetFramework)' == 'net10.0-maccatalyst'" />
        </ItemGroup>
        <PropertyGroup>
            <GoogleAuthConfigurationGenerated>true</GoogleAuthConfigurationGenerated>
        </PropertyGroup>
    </Target>

</Project>
